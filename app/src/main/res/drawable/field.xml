<?xml version="1.0" encoding="utf-8"?>
<!-- A settings field or button: a graphite plate, the accent blue rim when focused with the remote. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2E3038" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF4D6BFE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF26272C" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
