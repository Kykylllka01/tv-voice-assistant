<?xml version="1.0" encoding="utf-8"?>
<!-- The main settings action: accent blue, a white rim when focused with the remote. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B78FF" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFF8FAFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF4D6BFE" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
